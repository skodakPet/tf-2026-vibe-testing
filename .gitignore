node_modules/

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/
.playwright-cli/
.playwright-mcp/
# the healer writes its page snapshot here
snapshot.txt
# agents sometimes drop CLI snapshots at the root instead of .playwright-cli/
/*.yml
*.webm
*.zip

# Generated by `npx playwright init-agents` / `init-skills` during the workshop, at any depth.
# Committed copies live in each exhibit's solutions/ folder instead.
#.claude/
.agents/
**/.github/skills/*
# …except the workshop skills this repository ships
!/.github/skills/team-setup/
!/.github/skills/battle-setup/
!/.github/skills/foodora-smoke/
# …and each team's own skill, team-N-<name>
!/.github/skills/team-*/
**/.github/agents/
**/.github/prompts/
**/.github/workflows/copilot-setup-steps.yml
**/.vscode/mcp.json
!/.vscode/mcp.json
/specs/

# What you produce in the Zoo stays on your laptop — the exhibits are practice, and the work you
# share lives in teams/. The seed test and the READMEs are tracked and unaffected.
experiments/1_Zoo/*/tests/*.spec.ts
experiments/1_Zoo/*/specs/*.md
!experiments/1_Zoo/*/specs/README.md
experiments/2_API/tests/*.spec.ts

# Secrets — the Vercel AI Gateway key and the Wopee API key never land in the repo
.env
.env.local
*.local

# Editor / OS
.DS_Store
.idea/
